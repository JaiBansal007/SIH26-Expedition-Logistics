# Infrastructure Environment Variables
# These are loaded by docker-compose files

# PostgreSQL Configuration
POSTGRES_DB=cargo_tracking
POSTGRES_USER=cargo
POSTGRES_PASSWORD=cargo_dev_password_123

# Redis Configuration
REDIS_PASSWORD=cargo_redis_password

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# Development URLs (for reference)
DATABASE_URL=postgresql://cargo:cargo_dev_password_123@localhost:5432/cargo_tracking
REDIS_URL=redis://:cargo_redis_password@localhost:6379
KAFKA_BROKERS=localhost:9092
