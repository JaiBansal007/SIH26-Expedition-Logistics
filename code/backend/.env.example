# Server Configuration
PORT=3000

# Database Configuration (from infra setup)
DATABASE_URL=postgresql://cargo:cargo_dev_password_123@localhost:5432/cargo_tracking

# Database Configuration (Individual Fields)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cargo
DB_PASSWORD=cargo_dev_password_123
DB_NAME=cargo_tracking

# Authentication
JWT_SECRET=your-super-secret-jwt-key-here
#
# API Configuration
API_URL=http://localhost:3000

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=api-data-topic

# LocationIQ Reverse Geocoding API
REVERSE_PROXY_URL=https://us1.locationiq.com/v1/reverse.php

# OLA Maps API (Optional)
OLA_API_KEY=your-ola-api-key

# Email Notifications (using Mailhog for development)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@cargotracking.com

# Alert Processing
ENABLE_ALERT_PROCESSING=true
ALERT_PROCESSING_INTERVAL=1200000
ALERT_BATCH_SIZE=100